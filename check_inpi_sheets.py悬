import pandas as pd

inpi_path = r"c:\Users\aicil\OneDrive\Escritorio\PVU\SARAMPIÓN\mezquital\POBLACION\POBLACION APROXIMADA DE ALGUNAS LOCALIDADES DE MEZQUITAL.xlsx"

try:
    xl = pd.ExcelFile(inpi_path)
    print("Sheets in INPI file:", xl.sheet_names)
    
    for sheet in xl.sheet_names:
        df = pd.read_excel(inpi_path, sheet_name=sheet, header=None)
        print(f"\n--- Sheet: {sheet} ---")
        row3 = df.iloc[3].tolist()
        # Find all non-nan headers in row 3
        locs = [str(x) for x in row3 if str(x) != 'nan']
        print(f"Localities found in Row 3: {locs}")
        
except Exception as e:
    print(f"Error reading file: {e}")
