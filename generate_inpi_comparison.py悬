import pandas as pd

# Data for the 5 INPI localities
# Note: Since they do not appear in the Concentrado, their applied doses are 0.
data = [
    {"Localidad": "AGUA VERDE", "Dosis Aplicadas (Concentrado)": 0, "Población (INPI)": 167, "Población (INEGI 2020)": 142},
    {"Localidad": "AGUA FRIA", "Dosis Aplicadas (Concentrado)": 0, "Población (INPI)": 171, "Población (INEGI 2020)": 0},
    {"Localidad": "YERBANIZ", "Dosis Aplicadas (Concentrado)": 0, "Población (INPI)": 219, "Población (INEGI 2020)": 130},
    {"Localidad": "TACHICHILPA", "Dosis Aplicadas (Concentrado)": 0, "Población (INPI)": 405, "Población (INEGI 2020)": 89},
    {"Localidad": "SAN PEDRO DE XICORAS", "Dosis Aplicadas (Concentrado)": 0, "Población (INPI)": 501, "Población (INEGI 2020)": 270}
]

df = pd.DataFrame(data)

# Calculate coverages (will be 0% since doses are 0, but setting the formula up properly)
df['Cobertura (INPI)'] = (df['Dosis Aplicadas (Concentrado)'] / df['Población (INPI)']).fillna(0)
df['Cobertura (INEGI)'] = (df['Dosis Aplicadas (Concentrado)'] / df['Población (INEGI 2020)']).fillna(0).replace([float('inf'), -float('inf')], 0)

output_excel = r"C:\Users\aicil\OneDrive\Escritorio\PVU\SARAMPIÓN\mezquital\INFORMES\Comparativa_Cobertura_INPI_vs_INEGI_Mezquital.xlsx"

with pd.ExcelWriter(output_excel, engine='xlsxwriter') as writer:
    df.to_excel(writer, index=False, sheet_name='Comparativa INPI vs INEGI')
    
    workbook = writer.book
    worksheet = writer.sheets['Comparativa INPI vs INEGI']
    
    header_f = workbook.add_format({'bold': True, 'bg_color': '#D7E4BC', 'border': 1, 'text_wrap': True, 'valign': 'top'})
    percent_f = workbook.add_format({'num_format': '0.00%', 'border': 1})
    normal_f = workbook.add_format({'border': 1})
    
    for c, v in enumerate(df.columns):
        worksheet.write(0, c, v, header_f)
        worksheet.set_column(c, c, 20)
        
        if 'Cobertura' in v:
            for r in range(1, len(df) + 1):
                worksheet.write(r, c, df.iloc[r-1, c], percent_f)
        else:
            for r in range(1, len(df) + 1):
                worksheet.write(r, c, df.iloc[r-1, c], normal_f)

print(f"Excel saved: {output_excel}")
